{
  "expo": {
    "name": "RN Effects",
    "slug": "react-native-effects-example",
    "version": "1.0.0",
    "scheme": "react-native-effects-example",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "bundleIdentifier": "com.blazejkustra.rneffects",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.blazejkustra.rneffects"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "react-native-audio-api",
        {
          "iosMicrophonePermission": "RN Effects uses the microphone so the shaders react to your voice."
        }
      ]
    ]
  }
}
